# Copy to .env in this directory. Do not commit the resulting .env.
USE_EXTERNAL_AI="true"
USE_EXTERNAL_OPENAI="true"
OPENAI_API_KEY="<YOUR_OPENAI_API_KEY>"
OPENAI_MODEL="gpt-5.4"

# Workshop output ceilings, not model context-window sizes.
# The supplied code otherwise defaults to 131072, above GPT-5.4's documented
# 128000 maximum output tokens. Parameter compatibility is checked separately.
EXTERNAL_ORCH_MAX_TOKENS="128000"
EXTERNAL_LLM_MAX_TOKENS="128000"

TAVILY_API_KEY="<YOUR_TAVILY_API_KEY>" # REQUIRED
FINNHUB_API_KEY="<YOUR_FUNNHUB_API_KEY>"" # REQUIRED
